# Example environment configuration for THALI x P.L.A.T.E.
# Copy to `.env` and fill real values at deployment time.
# NEVER commit real credentials or secrets to source control.

THALI_APP__ENV=development
THALI_APP__NAME=THALI-PLATE
THALI_APP__VERSION=0.1.0

# Database (PostgreSQL)
THALI_DATABASE__URL=postgresql+psycopg://thali_user:thali_rehearsal_password@localhost:5432/thali_db
THALI_DATABASE__POOL_SIZE=5
THALI_DATABASE__MAX_OVERFLOW=10

# Redis Cache / Rate Limiting
THALI_REDIS__ENABLED=false
THALI_REDIS__HOST=localhost
THALI_REDIS__PORT=6379
THALI_REDIS__PASSWORD=
THALI_REDIS__DB=0

# S3-Compatible Object Storage (MinIO)
THALI_STORAGE__ENDPOINT_URL=http://localhost:9000
THALI_STORAGE__BUCKET=thali-documents
THALI_STORAGE__REGION=ap-south-1
THALI_STORAGE__ACCESS_KEY_ID=thali_minio_dev
THALI_STORAGE__SECRET_ACCESS_KEY=thali_minio_secret_dev

# Custom RS256 JWT Authentication (No Keycloak)
# Run `python -m scripts.generate_dev_keys` to generate dev keys and .env
THALI_AUTH__PRIVATE_KEY_PEM=
THALI_AUTH__PUBLIC_KEY_PEM=
THALI_AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=60
THALI_AUTH__REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Database Seeder
THALI_SEED_ENABLED=true
THALI_SEED_ADMIN_PASSWORD=admin-change-me-2026

# WhatsApp Channel (Meta Cloud API / Webhook) — LIVE
# Meta App: THALI X P.L.A.T.E. | Live number: +91 99035 46271 | WABA ID: 1999011964090146
# PHONE_NUMBER_ID is the numeric phone number ID for +91 99035 46271 (not the WABA ID).
THALI_WHATSAPP__VERIFY_TOKEN=thali-verify-dev
THALI_WHATSAPP__APP_SECRET=
THALI_WHATSAPP__ACCESS_TOKEN=
THALI_WHATSAPP__PHONE_NUMBER_ID=
THALI_WHATSAPP__BUSINESS_ACCOUNT_ID=1999011964090146
THALI_WHATSAPP__API_VERSION=v25.0
# Keep false for live operation so unregistered senders are never routed to a random patient.
THALI_WHATSAPP__TEST_NUMBER_MODE=false
# Welcome templates preference (comma-separated); first APPROVED by Meta is used,
# else falls back to free-form text (only delivered inside a 24h customer window).
THALI_WHATSAPP__WELCOME_TEMPLATE_NAMES=thali_welcome,thali_welcome_greeting,hello_world

# AI Provider (Provider-neutral draft generator)
THALI_AI__PROVIDER=deterministic
THALI_AI__MODEL=
THALI_AI__API_KEY=

# Observability
THALI_OBSERVABILITY__LOG_LEVEL=INFO
THALI_OBSERVABILITY__STRUCTURED_LOGS=false
THALI_OBSERVABILITY__METRICS_ENABLED=false
THALI_OBSERVABILITY__TRACING_ENABLED=false

# Security
THALI_SECURITY__ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
THALI_SECURITY__SESSION_TTL_MINUTES=60
