# Example environment configuration for THALI x P.L.A.T.E.
# Copy to `.env` and fill real values at deployment time.
# NEVER commit real credentials or secrets to source control.

THALI_APP__ENV=development
THALI_APP__NAME=THALI-PLATE
THALI_APP__VERSION=0.1.0

# Database (PostgreSQL)
THALI_DATABASE__URL=postgresql+psycopg://thali_user:thali_password@localhost:5432/thali_db
THALI_DATABASE__POOL_SIZE=5
THALI_DATABASE__MAX_OVERFLOW=10

# Redis Cache / Ephemeral State
THALI_REDIS__HOST=localhost
THALI_REDIS__PORT=6379
THALI_REDIS__PASSWORD=
THALI_REDIS__DB=0

# S3-Compatible Object Storage
THALI_STORAGE__ENDPOINT_URL=http://localhost:9000
THALI_STORAGE__BUCKET=thali-documents
THALI_STORAGE__REGION=ap-south-1
THALI_STORAGE__ACCESS_KEY_ID=minioadmin
THALI_STORAGE__SECRET_ACCESS_KEY=minioadmin

# Identity & Access Management (Keycloak)
# Production trust boundary: RS256 tokens verified against the realm JWKS.
THALI_IDENTITY__ISSUER_URL=http://localhost:8080/realms/thali
THALI_IDENTITY__REALM=thali
# Backend client/resource identifier — also the expected JWT audience.
THALI_IDENTITY__CLIENT_ID=thali-backend
THALI_IDENTITY__CLIENT_SECRET=
# Comma-separated algorithm allow-list. RS256 is the production policy.
# HS256 exists only for development/testing and MUST be overridden explicitly.
THALI_IDENTITY__ALLOWED_ALGORITHMS=RS256
# Explicit JWKS endpoint. When empty, OIDC discovery metadata from
# THALI_IDENTITY__ISSUER_URL is used (/.well-known/openid-configuration).
THALI_IDENTITY__JWKS_URI=

# WhatsApp Channel (Meta Cloud API - deferred)
THALI_WHATSAPP__VERIFY_TOKEN=
THALI_WHATSAPP__ACCESS_TOKEN=
THALI_WHATSAPP__PHONE_NUMBER_ID=
THALI_WHATSAPP__API_VERSION=v21.0

# AI Provider (Provider-neutral draft generator)
THALI_AI__PROVIDER=gemini
THALI_AI__MODEL=gemini-1.5-pro
THALI_AI__API_KEY=

# Observability
THALI_OBSERVABILITY__LOG_LEVEL=INFO
THALI_OBSERVABILITY__STRUCTURED_LOGS=false
THALI_OBSERVABILITY__METRICS_ENABLED=false
THALI_OBSERVABILITY__TRACING_ENABLED=false

# Security
THALI_SECURITY__ALLOWED_ORIGINS=[]
THALI_SECURITY__SESSION_TTL_MINUTES=60
