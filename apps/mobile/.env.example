# apps/mobile client-safe environment configuration
#
# These values are embedded into the app bundle at build time (EXPO_PUBLIC_*).
# NEVER put secrets here: no JWT_SECRET, no DATABASE_URL, no client_secret,
# no WhatsApp/S3 keys. Secrets stay server-side (Mobile is a public OIDC client).

EXPO_PUBLIC_ENVIRONMENT=development

# When testing on desktop emulator / simulator, localhost works:
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/thali

# When testing on physical iOS/Android device over local Wi-Fi, run:
#   ./scripts/detect_lan_ip.sh
# and replace localhost with your workstation LAN IP (e.g., 192.168.1.50):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:8000
# EXPO_PUBLIC_KEYCLOAK_ISSUER_URL=http://192.168.1.50:8080/realms/thali

EXPO_PUBLIC_KEYCLOAK_REALM=thali
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=thali-mobile-app
EXPO_PUBLIC_KEYCLOAK_REDIRECT_URI=thali://auth/callback

# Space-separated OIDC scopes requested in the Authorization Code + PKCE flow.
# "offline_access" yields a refresh token (required for session restoration).
EXPO_PUBLIC_KEYCLOAK_SCOPES=openid profile email offline_access

# Enable real authentication (true activates Keycloak OIDC/PKCE; false shows unconfigured safe screen)
EXPO_PUBLIC_AUTH_ENABLED=false