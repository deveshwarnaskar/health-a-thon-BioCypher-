{
  "expo": {
    "name": "THALI x P.L.A.T.E.",
    "slug": "thali-plate",
    "version": "0.1.0",
    "scheme": "thali",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.thali.plate.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "THALI requires camera access to scan food plates for nutritional intake analysis and capture medical documents.",
        "NSMicrophoneUsageDescription": "THALI requires microphone access for voice symptom logging, dictation, and voice consultations."
      }
    },
    "android": {
      "package": "in.thali.plate.mobile",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0D5C75",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ]
  }
}
