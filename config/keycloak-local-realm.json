{
  "realm": "thali",
  "displayName": "THALI + P.L.A.T.E. Development Realm",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 43200,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespan": 5184000,
  "clientSessionIdleTimeout": 3600,
  "clientSessionMaxLifespan": 43200,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "defaultSignatureAlgorithm": "RS256",
  "roles": {
    "realm": [
      {
        "name": "Patient",
        "description": "Patient user with access to personal health record, vitals, and meal logging"
      },
      {
        "name": "Caregiver",
        "description": "Authorized family member or proxy caregiver with consented read/assisted write capabilities"
      },
      {
        "name": "Doctor",
        "description": "Licensed physician authorized for clinical oversight, diagnosis, and medication plans"
      },
      {
        "name": "Nurse",
        "description": "Clinical staff member managing care execution and vitals verification"
      },
      {
        "name": "Care Coordinator",
        "description": "Operational care manager orchestrating patient onboarding and care team scheduling"
      },
      {
        "name": "Dietitian/Diabetes Educator",
        "description": "Allied health professional reviewing nutritional observations and patient education"
      },
      {
        "name": "Field Health Worker",
        "description": "Frontline community health worker conducting home visits and vital checks"
      },
      {
        "name": "Admin",
        "description": "Platform administrator managing facilities, care team provisioning, and identity mappings"
      },
      {
        "name": "patient",
        "description": "Canonical token for patient"
      },
      {
        "name": "caregiver",
        "description": "Canonical token for caregiver"
      },
      {
        "name": "doctor",
        "description": "Canonical token for doctor"
      },
      {
        "name": "nurse",
        "description": "Canonical token for nurse"
      },
      {
        "name": "care_coordinator",
        "description": "Canonical token for care coordinator"
      },
      {
        "name": "dietitian",
        "description": "Canonical token for dietitian"
      },
      {
        "name": "field_health_worker",
        "description": "Canonical token for field health worker"
      },
      {
        "name": "admin",
        "description": "Canonical token for admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "thali-backend-api",
      "name": "THALI Backend API Service",
      "description": "Audience identifier and resource server for FastAPI backend",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "thali-mobile-app",
      "name": "THALI Mobile App Client",
      "description": "Public React Native client for patients, caregivers, and clinicians (PKCE S256)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "redirectUris": [
        "thali://oauth/callback",
        "thali://auth/callback",
        "thali://*",
        "in.thali.plate.mobile://oauth/callback",
        "in.thali.plate.mobile://auth/callback",
        "in.thali.plate.mobile://*",
        "http://localhost:8081/*",
        "exp://*"
      ],
      "webOrigins": [
        "*"
      ],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "facility_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "facility_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "facility_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "audience_mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "thali-backend-api",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
