{
  "title": "THALI P.L.A.T.E. - External Dependencies Health & Operational Outcomes",
  "uid": "thali-dependencies",
  "tags": ["thali", "dependencies", "gate-10p-d"],
  "timezone": "utc",
  "schemaVersion": 38,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Dependency Health Status (1=Up, 0=Down)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "dependency_health_status",
          "legendFormat": "{{dependency}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Dependency Operational Failures (errors/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(dependency_failures_total[1m])) by (dependency, error_type)",
          "legendFormat": "{{dependency}} ({{error_type}})"
        }
      ]
    },
    {
      "id": 3,
      "title": "WhatsApp Cloud API Delivery Outcomes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(whatsapp_deliveries_total[1m])) by (outcome)",
          "legendFormat": "WhatsApp: {{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "AI Adapter Generation Outcomes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum(rate(ai_generation_requests_total[1m])) by (outcome)",
          "legendFormat": "AI Generation: {{outcome}}"
        }
      ]
    }
  ]
}
