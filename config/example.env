# Example environment file for the THALI x P.L.A.T.E. target configuration.
#
# COPY to `config/.env` (or project root `.env`) and fill real values at
# deploy time. NEVER commit real credentials. All values below are safe
# placeholders.

THALI_APP__ENV=development
THALI_APP__NAME=THALI-PLATE
THALI_APP__VERSION=0.1.0

THALI_DATABASE__URL=

THALI_REDIS__HOST=localhost
THALI_REDIS__PORT=6379

THALI_STORAGE__ENDPOINT_URL=
THALI_STORAGE__BUCKET=

THALI_IDENTITY__ISSUER_URL=
THALI_IDENTITY__REALM=

THALI_WHATSAPP__VERIFY_TOKEN=
THALI_WHATSAPP__ACCESS_TOKEN=
THALI_WHATSAPP__PHONE_NUMBER_ID=
THALI_WHATSAPP__API_VERSION=v21.0

THALI_AI__PROVIDER=gemini
THALI_AI__MODEL=

THALI_OBSERVABILITY__LOG_LEVEL=INFO

THALI_SECURITY__ALLOWED_ORIGINS=[]